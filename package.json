{
	"name": "burrowgate",
	"version": "1.1.0",
	"private": true,
	"type": "module",
	"description": "Self-hosted reverse proxy with route policies, GeoIP network controls, challenges, rate limiting, TLS, and traffic monitoring.",
	"scripts": {
		"dev": "bun --watch src/index.ts",
		"start": "bun src/index.ts",
		"test": "bun test",
		"typecheck": "bunx tsc --noEmit",
		"origin": "bun examples/origin.ts",
		"build:map": "bun scripts/build-map-assets.ts"
	},
	"dependencies": {
		"@rabbit-company/openmetrics-client": "2.0.1",
		"@rabbit-company/web": "^0.18.2",
		"@rabbit-company/web-middleware": "^0.18.2",
		"acme-client": "5.4.0",
		"chart.js": "4.5.1",
		"maxmind": "5.0.7"
	},
	"devDependencies": {
		"@types/bun": "1.3.14",
		"typescript": "^7.0.2"
	},
	"engines": {
		"bun": ">=1.3.14"
	}
}
