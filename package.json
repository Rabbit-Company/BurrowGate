{
	"name": "burrowgate",
	"version": "1.42.0",
	"private": true,
	"type": "module",
	"description": "Self-hosted reverse proxy with route policies, GeoIP, rate limiting, managed WAF, browser challenges, TLS termination, and traffic monitoring.",
	"license": "EUPL-1.2",
	"scripts": {
		"dev": "bun --watch src/index.ts",
		"start": "bun src/index.ts",
		"test": "bun test",
		"typecheck": "bunx tsc --noEmit",
		"origin": "bun examples/origin.ts",
		"example:cross-site-auth": "bun run build:auth-sdk && bun --env-file=examples/cross-site-auth/.env examples/cross-site-auth/start.ts",
		"build:map": "bun scripts/build-map-assets.ts",
		"build:auth-sdk": "bunx tsc -p packages/burrowgate-auth/tsconfig.json",
		"bench": "bun bench/run-all.ts --repeat 15 --duration 3000",
		"bench:compare": "bun bench/compare.ts"
	},
	"dependencies": {
		"@rabbit-company/openmetrics-client": "2.0.1",
		"@rabbit-company/totp": "^1.0.1",
		"@rabbit-company/web": "^0.18.2",
		"@rabbit-company/web-middleware": "^0.18.2",
		"@simplewebauthn/server": "^14.0.0",
		"acme-client": "5.4.0",
		"chart.js": "4.5.1",
		"jose": "^6.2.10",
		"maxmind": "5.0.7",
		"qrcode": "^1.5.4"
	},
	"devDependencies": {
		"@types/bun": "1.4.0",
		"@types/qrcode": "^1.5.6",
		"typescript": "^7.0.2"
	},
	"engines": {
		"bun": ">=1.4.0"
	}
}
