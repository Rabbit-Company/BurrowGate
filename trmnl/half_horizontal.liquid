{% comment %}Source template. Run python3 trmnl/build.py after edits.{% endcomment %}
{%- comment -%}Compute displayed dates via pure integer calendar math (Howard Hinnant's days_from_civil/civil_from_days) instead of the date filter, so the renderer's own time zone can never leak in; trmnl.user.utc_offset is applied by hand to reach the device's local time.{%- endcomment -%}
{%- assign date_style = trmnl.plugin_settings.custom_fields_values.date_format | default: 'iso' -%}
{%- assign time_style = trmnl.plugin_settings.custom_fields_values.time_format | default: 'twenty_four_seconds' -%}
{%- assign utc_offset = trmnl.user.utc_offset | default: 0 -%}
{%- assign timestamps = from | append: '|' | append: to | append: '|' | append: generatedAt | split: '|' -%}
{%- capture formatted_dates -%}
  {%- for timestamp in timestamps -%}
    {%- assign y = timestamp | slice: 0, 4 | plus: 0 -%}
    {%- assign mo = timestamp | slice: 5, 2 | plus: 0 -%}
    {%- assign da = timestamp | slice: 8, 2 | plus: 0 -%}
    {%- assign ho = timestamp | slice: 11, 2 | plus: 0 -%}
    {%- assign mi = timestamp | slice: 14, 2 | plus: 0 -%}
    {%- assign se = timestamp | slice: 17, 2 | plus: 0 -%}
    {%- comment -%}days_from_civil{%- endcomment -%}
    {%- assign cy = y -%}
    {%- if mo <= 2 -%}{%- assign cy = cy | minus: 1 -%}{%- endif -%}
    {%- assign era = cy | divided_by: 400 -%}
    {%- assign era_400 = era | times: 400 -%}
    {%- assign yoe = cy | minus: era_400 -%}
    {%- assign m_adj = 9 -%}
    {%- if mo > 2 -%}{%- assign m_adj = -3 -%}{%- endif -%}
    {%- assign doy = mo | plus: m_adj | times: 153 | plus: 2 | divided_by: 5 | plus: da | minus: 1 -%}
    {%- assign yoe_365 = yoe | times: 365 -%}
    {%- assign yoe_div4 = yoe | divided_by: 4 -%}
    {%- assign yoe_div100 = yoe | divided_by: 100 -%}
    {%- assign doe = yoe_365 | plus: yoe_div4 | minus: yoe_div100 | plus: doy -%}
    {%- assign era_146097 = era | times: 146097 -%}
    {%- assign days = era_146097 | plus: doe | minus: 719468 -%}
    {%- comment -%}apply the offset in whole seconds{%- endcomment -%}
    {%- assign day_sec = days | times: 86400 -%}
    {%- assign hour_sec = ho | times: 3600 -%}
    {%- assign minute_sec = mi | times: 60 -%}
    {%- assign epoch = day_sec | plus: hour_sec | plus: minute_sec | plus: se -%}
    {%- assign shifted = epoch | plus: utc_offset -%}
    {%- assign shifted_days = shifted | divided_by: 86400 -%}
    {%- assign seconds_of_day = shifted | modulo: 86400 -%}
    {%- assign out_hour = seconds_of_day | divided_by: 3600 -%}
    {%- assign seconds_rem = seconds_of_day | modulo: 3600 -%}
    {%- assign out_minute = seconds_rem | divided_by: 60 -%}
    {%- assign out_second = seconds_rem | modulo: 60 -%}
    {%- comment -%}civil_from_days{%- endcomment -%}
    {%- assign z = shifted_days | plus: 719468 -%}
    {%- assign era2 = z | divided_by: 146097 -%}
    {%- assign era2_146097 = era2 | times: 146097 -%}
    {%- assign doe2 = z | minus: era2_146097 -%}
    {%- assign doe2_div1460 = doe2 | divided_by: 1460 -%}
    {%- assign doe2_div36524 = doe2 | divided_by: 36524 -%}
    {%- assign doe2_div146096 = doe2 | divided_by: 146096 -%}
    {%- assign yoe2_num = doe2 | minus: doe2_div1460 | plus: doe2_div36524 | minus: doe2_div146096 -%}
    {%- assign yoe2 = yoe2_num | divided_by: 365 -%}
    {%- assign era2_400 = era2 | times: 400 -%}
    {%- assign y2 = yoe2 | plus: era2_400 -%}
    {%- assign yoe2_365 = yoe2 | times: 365 -%}
    {%- assign yoe2_div4 = yoe2 | divided_by: 4 -%}
    {%- assign yoe2_div100 = yoe2 | divided_by: 100 -%}
    {%- assign inner2 = yoe2_365 | plus: yoe2_div4 | minus: yoe2_div100 -%}
    {%- assign doy2 = doe2 | minus: inner2 -%}
    {%- assign mp = doy2 | times: 5 | plus: 2 | divided_by: 153 -%}
    {%- assign mp_term = mp | times: 153 | plus: 2 | divided_by: 5 -%}
    {%- assign d2 = doy2 | minus: mp_term | plus: 1 -%}
    {%- assign m_adj2 = 3 -%}
    {%- if mp >= 10 -%}{%- assign m_adj2 = -9 -%}{%- endif -%}
    {%- assign m2 = mp | plus: m_adj2 -%}
    {%- assign y_final = y2 -%}
    {%- if m2 <= 2 -%}{%- assign y_final = y2 | plus: 1 -%}{%- endif -%}
    {%- capture month_text -%}{%- if m2 < 10 -%}0{%- endif -%}{{ m2 }}{%- endcapture -%}
    {%- capture day_text -%}{%- if d2 < 10 -%}0{%- endif -%}{{ d2 }}{%- endcapture -%}
    {%- capture hour24_text -%}{%- if out_hour < 10 -%}0{%- endif -%}{{ out_hour }}{%- endcapture -%}
    {%- capture minute_text -%}{%- if out_minute < 10 -%}0{%- endif -%}{{ out_minute }}{%- endcapture -%}
    {%- capture second_text -%}{%- if out_second < 10 -%}0{%- endif -%}{{ out_second }}{%- endcapture -%}
    {%- capture date_text -%}
      {%- case date_style -%}
        {%- when 'day_first_dots' -%}{{ day_text }}.{{ month_text }}.{{ y_final }}
        {%- when 'day_first_slashes' -%}{{ day_text }}/{{ month_text }}/{{ y_final }}
        {%- when 'month_first_slashes' -%}{{ month_text }}/{{ day_text }}/{{ y_final }}
        {%- else -%}{{ y_final }}-{{ month_text }}-{{ day_text }}
      {%- endcase -%}
    {%- endcapture -%}
    {%- capture time_text -%}
      {%- if time_style == 'twelve' or time_style == 'twelve_seconds' -%}
        {%- assign clock_hour = out_hour | modulo: 12 -%}
        {%- if clock_hour == 0 -%}{%- assign clock_hour = 12 -%}{%- endif -%}
        {%- if clock_hour < 10 -%}0{%- endif -%}{{ clock_hour }}:{{ minute_text }}
        {%- if time_style == 'twelve_seconds' -%}:{{ second_text }}{%- endif -%}
        {{- ' ' -}}{% if out_hour < 12 %}AM{% else %}PM{% endif %}
      {%- elsif time_style == 'twenty_four' -%}{{ hour24_text }}:{{ minute_text }}
      {%- else -%}{{ hour24_text }}:{{ minute_text }}:{{ second_text }}
      {%- endif -%}
    {%- endcapture -%}
    {{- date_text }} {{ time_text -}}{%- unless forloop.last -%}|{%- endunless -%}
  {%- endfor -%}
{%- endcapture -%}
{%- assign date_labels = formatted_dates | split: '|' -%}
<style>
  .bg-monitor { width: 100%; height: 100%; display: flex; flex-direction: column; gap: 12px; font-family: "Inter", Arial, sans-serif; }
  .bg-monitor * { box-sizing: border-box; }
  .bg-monitor .bg-heading { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; border-bottom: 2px solid currentColor; padding-bottom: 8px; }
  .bg-monitor .bg-heading strong { font-size: 24px; line-height: 1.1; }
  .bg-monitor .bg-scope { font-size: 15px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 40%; }
  .bg-monitor .bg-stats { display: flex; gap: 20px; }
  .bg-monitor .bg-stat { flex: 1; min-width: 0; }
  .bg-monitor .bg-number { font-size: 34px; font-weight: 700; line-height: 1.1; white-space: nowrap; }
  .bg-monitor .bg-unit { font-size: 14px; font-weight: 400; }
  .bg-monitor .bg-label { font-size: 15px; }
  .bg-monitor .bg-chart { flex: 1; min-height: 40px; display: flex; flex-direction: column; gap: 4px; }
  .bg-monitor .bg-scale, .bg-monitor .bg-axis { display: flex; justify-content: space-between; font-size: 13px; }
  .bg-monitor .bg-plot-row { flex: 1; min-height: 20px; display: flex; gap: 8px; padding: 6px 0; }
  .bg-monitor .bg-plot { position: relative; flex: 1; min-width: 0; }
  .bg-monitor .bg-gridline { position: absolute; left: 0; right: 0; border-top: 1px dotted currentColor; opacity: 0.3; }
  .bg-monitor .bg-bars { position: absolute; inset: 0; display: flex; align-items: flex-end; gap: 2px; }
  .bg-monitor .bg-line-chart { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .bg-monitor .bg-values { position: relative; min-width: 48px; font-size: 12px; font-variant-numeric: tabular-nums; }
  .bg-monitor .bg-tick { position: absolute; right: 0; transform: translateY(-50%); white-space: nowrap; }
  .bg-monitor .bg-axis { gap: 8px; font-size: 11px; }
  .bg-monitor .bg-axis span { max-width: 50%; }
  .bg-monitor .bg-axis span:last-child { text-align: right; }
  .bg-footer .instance { font-size: 12px; font-family: "Inter", Arial, sans-serif; }
  .bg-monitor .bg-slot { flex: 1; height: 100%; display: flex; align-items: flex-end; }
  .bg-monitor .bg-bar { width: 100%; background: currentColor; }
  .bg-monitor .bg-empty { flex: 1; display: flex; align-items: center; justify-content: center; text-align: center; font-size: 20px; }
  .bg-monitor .bg-countries { flex: 1; width: 100%; border-collapse: collapse; font-size: 20px; }
  .bg-monitor .bg-countries td { border-bottom: 1px solid currentColor; padding: 5px 0; }
  .bg-monitor .bg-countries td:last-child { text-align: right; font-weight: 700; }
  .bg-monitor.bg-half_horizontal, .bg-monitor.bg-quadrant { gap: 5px; }
  .bg-monitor.bg-half_horizontal .bg-heading strong, .bg-monitor.bg-quadrant .bg-heading strong { font-size: 18px; }
  .bg-monitor.bg-half_horizontal .bg-number, .bg-monitor.bg-quadrant .bg-number { font-size: 24px; }
  .bg-monitor.bg-half_vertical .bg-stats, .bg-monitor.bg-quadrant .bg-stats { gap: 8px; }
  .bg-monitor.bg-half_vertical .bg-number { font-size: 26px; }
  .bg-monitor.bg-half_vertical .bg-heading, .bg-monitor.bg-quadrant .bg-heading { display: block; }
  .bg-monitor.bg-half_vertical .bg-scope, .bg-monitor.bg-quadrant .bg-scope { display: block; max-width: 100%; font-size: 12px; }
  .bg-monitor.bg-quadrant .bg-label, .bg-monitor.bg-quadrant .bg-unit { font-size: 12px; }
  .bg-monitor.bg-half_horizontal .bg-countries, .bg-monitor.bg-quadrant .bg-countries { font-size: 14px; }
  .bg-monitor.bg-half_horizontal .bg-countries td, .bg-monitor.bg-quadrant .bg-countries td { padding: 1px 0; }
  .bg-monitor.bg-half_horizontal .bg-countries tr:nth-child(n+6), .bg-monitor.bg-quadrant .bg-countries tr:nth-child(n+6) { display: none; }
  @media (max-height: 700px) {
    .bg-monitor.bg-full .bg-countries tr:nth-child(n+7), .bg-monitor.bg-half_vertical .bg-countries tr:nth-child(n+7) { display: none; }
    .bg-monitor.bg-quadrant .bg-chart { display: none; }
    .bg-monitor.bg-quadrant .bg-stats { flex: 1; align-items: center; }
    .bg-monitor.bg-quadrant .bg-number { font-size: 30px; }
    .bg-monitor.bg-quadrant .bg-label { font-size: 14px; }
    .bg-monitor.bg-quadrant .bg-unit { font-size: 13px; }
    .bg-monitor.bg-half_horizontal .bg-countries tr:nth-child(n+4), .bg-monitor.bg-quadrant .bg-countries tr:nth-child(n+4) { display: none; }
  }
</style>
<div class="layout layout--col">
  <div class="bg-monitor bg-half_horizontal">
    {% if schemaVersion == 1 %}
      <div class="bg-heading">
        <strong>{{ title | escape }}</strong>
        <span class="bg-scope">{{ scope | escape }}</span>
      </div>
      <div class="bg-stats">
        {% for stat in stats limit: 3 %}
          {% assign stat_byte_multiplier = 0 %}
          {% case stat.unit %}
            {% when 'B' %}{% assign stat_byte_multiplier = 1 %}
            {% when 'KiB' %}{% assign stat_byte_multiplier = 1024 %}
            {% when 'MiB' %}{% assign stat_byte_multiplier = 1048576 %}
            {% when 'GiB' %}{% assign stat_byte_multiplier = 1073741824 %}
            {% when 'TiB' %}{% assign stat_byte_multiplier = 1099511627776 %}
          {% endcase %}
          <div class="bg-stat">
            <div class="bg-number">
              {% if stat.value == nil %}
                —
              {% elsif stat_byte_multiplier > 0 %}
                {% assign stat_bytes = stat.value | times: stat_byte_multiplier %}
                {% if stat_bytes >= 1099511627776 %}{{ stat_bytes | divided_by: 1099511627776.0 | round: 2 }} <span class="bg-unit">TiB</span>
                {% elsif stat_bytes >= 1073741824 %}{{ stat_bytes | divided_by: 1073741824.0 | round: 2 }} <span class="bg-unit">GiB</span>
                {% elsif stat_bytes >= 1048576 %}{{ stat_bytes | divided_by: 1048576.0 | round: 2 }} <span class="bg-unit">MiB</span>
                {% elsif stat_bytes >= 1024 %}{{ stat_bytes | divided_by: 1024.0 | round: 2 }} <span class="bg-unit">KiB</span>
                {% else %}{{ stat_bytes | round: 0 }} <span class="bg-unit">B</span>
                {% endif %}
              {% elsif stat.value >= 1000000000 %}{{ stat.value | divided_by: 1000000000.0 | round: 1 }}B <span class="bg-unit">{{ stat.unit | escape }}</span>
              {% elsif stat.value >= 1000000 %}{{ stat.value | divided_by: 1000000.0 | round: 1 }}M <span class="bg-unit">{{ stat.unit | escape }}</span>
              {% elsif stat.value >= 10000 %}{{ stat.value | divided_by: 1000.0 | round: 1 }}k <span class="bg-unit">{{ stat.unit | escape }}</span>
              {% else %}{{ stat.value | round: 1 }} <span class="bg-unit">{{ stat.unit | escape }}</span>
              {% endif %}
            </div>
            <div class="bg-label">{{ stat.label | escape }}</div>
          </div>
        {% endfor %}
      </div>
      {% if hasData == false %}
        <div class="bg-empty">No samples in this range</div>
      {% elsif view == 'geography' %}
        <table class="bg-countries" aria-label="Requests by country">
          <tbody>
            {% for row in rows limit: 12 %}
              {%- assign country_code = row.label | upcase -%}
              {%- assign country_name = row.label -%}
