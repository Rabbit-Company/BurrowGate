      {% else %}
        <div class="bg-chart" role="img" aria-label="{{ title | escape }} over the last {{ hours | plus: 0 }} hours">
          {% assign chart_maximum = maximum | plus: 0 %}
          {% if chart_maximum <= 0 %}{% assign chart_maximum = 1 %}{% endif %}
          {% assign ticks = '100,50,0' | split: ',' %}
          {% assign chart_byte_multiplier = 0 %}
          {% case unit %}
            {% when 'B' %}{% assign chart_byte_multiplier = 1 %}
            {% when 'KiB' %}{% assign chart_byte_multiplier = 1024 %}
            {% when 'MiB' %}{% assign chart_byte_multiplier = 1048576 %}
            {% when 'GiB' %}{% assign chart_byte_multiplier = 1073741824 %}
            {% when 'TiB' %}{% assign chart_byte_multiplier = 1099511627776 %}
          {% endcase %}
          {% assign chart_display_unit = unit %}
          {% assign chart_ratio = 1.0 %}
          {% if chart_byte_multiplier > 0 %}
            {% assign chart_max_bytes = chart_maximum | times: chart_byte_multiplier %}
            {% assign chart_display_multiplier = 1 %}
            {% if chart_max_bytes >= 1099511627776 %}{% assign chart_display_multiplier = 1099511627776 %}{% assign chart_display_unit = 'TiB' %}
            {% elsif chart_max_bytes >= 1073741824 %}{% assign chart_display_multiplier = 1073741824 %}{% assign chart_display_unit = 'GiB' %}
            {% elsif chart_max_bytes >= 1048576 %}{% assign chart_display_multiplier = 1048576 %}{% assign chart_display_unit = 'MiB' %}
            {% elsif chart_max_bytes >= 1024 %}{% assign chart_display_multiplier = 1024 %}{% assign chart_display_unit = 'KiB' %}
            {% else %}{% assign chart_display_multiplier = 1 %}{% assign chart_display_unit = 'B' %}
            {% endif %}
            {% assign chart_ratio = chart_byte_multiplier | times: 1.0 | divided_by: chart_display_multiplier %}
          {% endif %}
          <div class="bg-scale"><span>{% if view == 'cache' or view == 'latency' or view == 'cpu' or view == 'memory' or view == 'disk' or view == 'network' %}Average per interval{% else %}Total per interval{% endif %}</span><span>{{ chart_display_unit | escape }}</span></div>
          <div class="bg-plot-row">
            <div class="bg-plot">
              {% for tick in ticks %}<div class="bg-gridline" style="top: {{ 100 | minus: tick }}%"></div>{% endfor %}
              {% if view == 'cpu' or view == 'memory' or view == 'disk' %}
                <svg class="bg-line-chart" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
                  {% assign intervals = points.size | minus: 1 | at_least: 1 %}
                  {% assign previous_value = nil %}
                  {% for point in points %}
                    {% assign x = forloop.index0 | times: 100.0 | divided_by: intervals %}
                    {% if point.value != nil %}
                      {% assign y = point.value | times: 100.0 | divided_by: chart_maximum | at_least: 0 | at_most: 100 %}
                      {% assign y = 100 | minus: y %}
                      {% if previous_value != nil %}<line x1="{{ previous_x }}" y1="{{ previous_y }}" x2="{{ x }}" y2="{{ y }}" stroke="currentColor" stroke-width="2" vector-effect="non-scaling-stroke" />{% endif %}
                      <line x1="{{ x }}" y1="{{ y }}" x2="{{ x }}" y2="{{ y }}" stroke="currentColor" stroke-width="2" stroke-linecap="round" vector-effect="non-scaling-stroke" />
                      {% assign previous_x = x %}{% assign previous_y = y %}
                    {% endif %}
                    {% assign previous_value = point.value %}
                  {% endfor %}
                </svg>
              {% else %}
                <div class="bg-bars">
                  {% for point in points %}<div class="bg-slot"><div class="bg-bar" style="height: {{ point.value | plus: 0 | times: 100.0 | divided_by: chart_maximum | at_least: 0 | at_most: 100 }}%"></div></div>{% endfor %}
                </div>
              {% endif %}
            </div>
            <div class="bg-values">
              {% for tick in ticks %}
                {% assign tick_value = chart_maximum | times: tick | divided_by: 100.0 %}
                <span class="bg-tick" style="top: {{ 100 | minus: tick }}%">{% if chart_byte_multiplier > 0 %}{% assign display_tick = tick_value | times: chart_ratio %}{% if display_tick >= 100 %}{{ display_tick | round: 0 }}{% elsif display_tick >= 10 %}{{ display_tick | round: 1 }}{% else %}{{ display_tick | round: 2 }}{% endif %}{% elsif tick_value >= 1000000000 %}{{ tick_value | divided_by: 1000000000.0 | round: 2 }}B{% elsif tick_value >= 1000000 %}{{ tick_value | divided_by: 1000000.0 | round: 2 }}M{% elsif tick_value >= 10000 %}{{ tick_value | divided_by: 1000.0 | round: 2 }}k{% elsif tick_value >= 1 %}{{ tick_value | round: 2 }}{% else %}{{ tick_value | round: 4 }}{% endif %}</span>
              {% endfor %}
            </div>
          </div>
          <div class="bg-axis"><span>{{ date_labels[0] | escape }}</span><span>{{ date_labels[1] | escape }}</span></div>
        </div>
      {% endif %}
    {% else %}
      <div class="bg-heading"><strong>BurrowGate</strong></div>
      <div class="bg-empty">Waiting for monitoring data.<br>Check your URL and token, then refresh.</div>
    {% endif %}
  </div>
</div>
<div class="title_bar bg-footer">
  <span class="title">BurrowGate</span>
  <span class="instance">{% if schemaVersion == 1 %}{{ hours | plus: 0 }}h · {{ date_labels[2] | escape }}{% else %}Monitoring{% endif %}</span>
</div>
