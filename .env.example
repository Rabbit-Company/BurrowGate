# BurrowGate is production-oriented by default and binds directly to ports 80 and 443.
BG_ENV=production
BG_HOST=0.0.0.0
BG_DATA_DIR=./data

# BG_PORT remains a backwards-compatible alias for BG_HTTP_PORT.
BG_PORT=80
BG_HTTP_ENABLED=true
BG_HTTP_PORT=80
BG_HTTP_PUBLIC_PORT=80
BG_HTTPS_ENABLED=true
BG_HTTPS_PORT=443
BG_HTTPS_PUBLIC_PORT=443

# Keeps port 443 available before the first trusted certificate is issued.
# Browsers will warn because this fallback certificate is self-signed.
BG_BOOTSTRAP_TLS_ENABLED=true

# Bun.SQL automatically detects SQLite, PostgreSQL, MySQL, or MariaDB.
DATABASE_URL=sqlite://./data/burrowgate.db

# Do not seed a fake localhost proxy in production. Create sites from the dashboard.
BG_SEED_DEFAULT_SITE=false
# These are used only when BG_SEED_DEFAULT_SITE=true and the sites table is empty.
BG_DEFAULT_SITE_NAME=Default site
BG_DEFAULT_PUBLIC_HOST=localhost
BG_DEFAULT_ORIGIN=http://127.0.0.1:3000
BG_DEFAULT_SESSION_TTL_SECONDS=43200
# Leading zero bits. Every +1 doubles expected work. Supported range: 8-63.
BG_DEFAULT_POW_DIFFICULTY=18
# challenge | bypass. Route policies can override this per path.
BG_DEFAULT_ACCESS_MODE=challenge

# direct | nginx | cloudflare | aws | development
# Use direct when BurrowGate owns public ports 80 and 443 itself.
BG_PROXY_PRESET=direct

# Dashboard credentials. Leave the password empty to generate and persist a strong
# bootstrap password in data/bootstrap-admin-password.txt on first startup.
BG_ADMIN_USERNAME=admin
BG_ADMIN_PASSWORD=
BG_ADMIN_SESSION_TTL_SECONDS=28800

# auto uses Secure cookies on HTTPS and ordinary cookies on HTTP.
# Set true to forbid HTTP cookies entirely. Doing so intentionally disables admin
# login and browser challenge sessions over plain HTTP. Keep auto when any site
# should remain usable through both HTTP and HTTPS.
BG_COOKIE_SECURE=auto
BG_ORIGIN_TIMEOUT_MS=30000

# Transparent ws:// and wss:// reverse proxying is enabled by default.
BG_WEBSOCKET_ENABLED=true
BG_WEBSOCKET_CONNECT_TIMEOUT_MS=15000
# Idle timeout is refreshed by data frames and protocol ping/pong traffic.
BG_WEBSOCKET_IDLE_TIMEOUT_SECONDS=120
BG_WEBSOCKET_MAX_PAYLOAD_BYTES=16777216
BG_WEBSOCKET_BACKPRESSURE_LIMIT_BYTES=16777216
BG_WEBSOCKET_UPSTREAM_BUFFER_LIMIT_BYTES=16777216
BG_WEBSOCKET_PREOPEN_QUEUE_LIMIT_BYTES=1048576

BG_CHALLENGE_TTL_SECONDS=180
BG_CHALLENGE_MIN_DISPLAY_MS=0
BG_MAX_CHALLENGE_ATTEMPTS=8
# Default traffic-event retention assigned to new sites (editable per site in the dashboard).
BG_EVENT_RETENTION_DAYS=7
BG_MAINTENANCE_INTERVAL_SECONDS=3600
BG_ADMIN_PAGE_SIZE=50

# Leave both empty to generate a persistent master key in data/master.key.
# Set one explicitly when using external secret management.
BG_MASTER_KEY=
# BG_MASTER_KEY_FILE=/run/secrets/burrowgate-master-key

# Production Let's Encrypt is the default. Use staging only while testing ACME.
BG_ACME_DIRECTORY_URL=https://acme-v02.api.letsencrypt.org/directory
BG_ACME_EMAIL=
BG_ACME_CHECK_INTERVAL_SECONDS=43200
BG_ACME_RENEW_BEFORE_DAYS=30
BG_ACME_CHALLENGE_TTL_SECONDS=900
BG_ACME_SKIP_INTERNAL_CHALLENGE_VERIFICATION=false