# Public URLs configured as two separate BurrowGate sites.
DEMO_FRONTEND_PUBLIC_ORIGIN=https://app.example.test
DEMO_BACKEND_PUBLIC_ORIGIN=https://api.example.test

DEMO_ALLOWED_FRONTEND_ORIGINS=https://app.example.test

# Local origins to configure in BurrowGate.
DEMO_FRONTEND_PORT=3100
DEMO_BACKEND_PORT=3200

# A URL at which the backend can reach this BurrowGate instance.
BURROWGATE_URL=https://app.example.test

# Replace both values using the frontend site's dashboard settings.
BURROWGATE_FRONTEND_SITE_ID=replace-with-frontend-site-id
BURROWGATE_SESSION_VERIFICATION_TOKEN=replace-with-generated-token

# Successful backend introspections are cached for this long. Set 0 to disable.
BURROWGATE_AUTH_CACHE_TTL_MS=5000