{
	"compilerOptions": {
		"target": "ES2023",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"exactOptionalPropertyTypes": true,
		"allowImportingTsExtensions": true,
		"types": ["bun"],
		"skipLibCheck": true,
		"noEmit": true
	},
	"include": ["src/**/*.ts", "tests/**/*.ts", "scripts/**/*.ts"]
}
